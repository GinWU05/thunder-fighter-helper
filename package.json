{
  "name": "thunder-fighter-helper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "sh -c 'pids=\"\"; trap \"kill $pids 2>/dev/null\" INT TERM EXIT; pnpm dev:pages & pids=\"$pids $!\"; pnpm dev:cron & pids=\"$pids $!\"; wait'",
    "dev:cron": "workers/reminder-cron/node_modules/.bin/wrangler dev --config workers/reminder-cron/wrangler.toml --test-scheduled --persist-to=.wrangler/state --port=8787 --inspector-port=9231",
    "dev:pages": "workers/reminder-cron/node_modules/.bin/wrangler pages dev --binding=REMINDER_SECRET=local-dev-secret --persist-to=.wrangler/state --port=8788 --inspector-port=9230 -- env NEXT_PUBLIC_API_BASE_URL= node_modules/.bin/next dev",
    "dev:pages:static": "workers/reminder-cron/node_modules/.bin/wrangler pages dev out --binding=REMINDER_SECRET=local-dev-secret --persist-to=.wrangler/state --port=8788 --inspector-port=9230",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
