{
  "name": "thunder-fighter-helper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "sh -c 'pids=\"\"; trap \"kill $pids 2>/dev/null\" INT TERM EXIT; pnpm dev & pids=\"$pids $!\"; pnpm dev:pages & pids=\"$pids $!\"; pnpm dev:cron & pids=\"$pids $!\"; wait'",
    "dev:cron": "pnpm --filter thunder-fighter-helper-cron dev:scheduled",
    "dev:pages": "workers/reminder-cron/node_modules/.bin/wrangler pages dev public --proxy=3000 --kv=REMINDERS_KV --binding=REMINDER_SECRET=local-dev-secret --persist-to=.wrangler/state --port=8788",
    "dev:pages:static": "workers/reminder-cron/node_modules/.bin/wrangler pages dev out --kv=REMINDERS_KV --binding=REMINDER_SECRET=local-dev-secret --persist-to=.wrangler/state --port=8788",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
